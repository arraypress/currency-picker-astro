{
  "name": "@arraypress/currency-picker-astro",
  "version": "1.0.0",
  "description": "Astro frontend currency picker — auto-detects from navigator.language, persists choice, rewrites every [data-price-original] on the page.",
  "type": "module",
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./CurrencyPicker.astro": "./src/CurrencyPicker.astro",
    "./presets": {
      "types": "./src/presets.ts",
      "default": "./src/presets.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "astro",
    "astro-component",
    "currency",
    "currency-picker",
    "currency-converter",
    "exchange-rate",
    "i18n",
    "ecommerce",
    "withastro"
  ],
  "author": "ArrayPress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arraypress/currency-picker-astro.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "astro": "^6.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "astro": "^6.3.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
